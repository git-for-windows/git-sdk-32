prefix=/mingw32
includedir=${prefix}/include
libdir=${prefix}/lib

p11_module_configs=/mingw32/share/p11-kit/modules
p11_module_path=/mingw32/lib/pkcs11
proxy_module=/mingw32/lib/p11-kit-proxy.dll
p11_system_config_modules=/mingw32/share/p11-kit/modules
p11_trust_paths=/mingw32/etc/pki/ca-trust/source:/mingw32/share/pki/ca-trust-source

Name: p11-kit
Description: Library and proxy module for properly loading and sharing PKCS#11 modules.
Version: 0.26.4
Libs: -L${libdir} -lp11-kit
Cflags: -I${includedir}/p11-kit-1
